{
  "name": "reminder-widget",
  "private": true,
  "version": "1.2.0",
  "description": "Always-on-top deadline reminder widget for Moodle/BRONE and iCalendar feeds",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zxaviers/reminder-widget.git"
  },
  "homepage": "https://github.com/Zxaviers/reminder-widget#readme",
  "bugs": {
