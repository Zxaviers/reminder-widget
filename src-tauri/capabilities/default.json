{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the widget, settings and BRONE login windows",
  "windows": ["main", "settings", "brone-login"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://brone.ub.ac.id/calendar/export_execute.php*" },
        { "url": "https://brone.ub.ac.id/calendar/export_execute.php?*" },
        { "url": "https://brone.ub.ac.id/calendar/export.php*" },
        { "url": "https://brone.ub.ac.id/calendar/export.php?*" }
      ]
    }
  ]
}
